#!/usr/bin/bash

source "$(dirname "$(realpath "$0")")/.shared"

[[ $# -ge 1 ]] || die_usage "Not enough arguments: $(basename "$0") <var>"
readonly VAR="${1}"

readonly ENTRY="${SECRET_STORE_PREFIX}/${PROJECT}/${ENV}/${VAR}"

# Exit codes: 1 — no such secret; 2 — secret exists but pass could not read it
# (gpg/pinentry/agent). Callers that treat "absent" as a normal state rely on
# the difference, so absence is decided by the store file, not by pass failing.
if [[ ! -f "${PASSWORD_STORE_DIR:-${HOME}/.password-store}/${ENTRY}.gpg" ]]; then
	echo "Secret not found: ${ENTRY}" >&2
	exit 1
fi

pass show "${ENTRY}" || {
	echo "Secret read failed: ${ENTRY}" >&2
	exit 2
}
