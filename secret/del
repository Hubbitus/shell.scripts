#!/usr/bin/bash

# shellcheck source-path=SCRIPTDIR
source "$(dirname "$(realpath "$0")")/.shared"

[[ $# -ge 1 ]] || die_usage "Not enough arguments: $(basename "$0") <var> [<var>...]"

# Exit codes, same contract as get: 1 — some secret did not exist (the others are still deleted); 2 — pass failed to move/remove an existing one.
# With SECRET_BACKUP=true (default) the entry is not destroyed but moved to _BAK/<var>.DEL.<timestamp>, like set keeps the replaced value — a mistaken delete stays recoverable.
rc=0
for VAR in "$@"; do
	ENTRY="${SECRET_STORE_PREFIX}/${PROJECT}/${ENV}/${VAR}"
	# Absence is decided by the store file, not by pass failing — as in get.
	if [[ ! -f "${PASSWORD_STORE_DIR:-${HOME}/.password-store}/${ENTRY}.gpg" ]]; then
		echo "Secret not found: ${ENTRY}" >&2
		[[ ${rc} -eq 0 ]] && rc=1
		continue
	fi
	if [[ 'true' == "${SECRET_BACKUP}" ]]; then
		BAK="${SECRET_STORE_PREFIX}/${PROJECT}/${ENV}/_BAK/${VAR}.DEL.$(date --iso-8601=ns)"
		if pass mv "${ENTRY}" "${BAK}" &>/dev/null; then
			echo "Deleted: ${ENTRY} (backup: ${BAK})" >&2
		else
			echo "Secret delete failed: ${ENTRY}" >&2
			rc=2
		fi
	else
		if pass rm --force "${ENTRY}" &>/dev/null; then
			echo "Deleted: ${ENTRY}" >&2
		else
			echo "Secret delete failed: ${ENTRY}" >&2
			rc=2
		fi
	fi
done
exit "${rc}"
