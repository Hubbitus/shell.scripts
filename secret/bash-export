#!/usr/bin/bash

source "$(dirname "$(realpath "$0")")/.shared"

[[ $# -ge 1 ]] || die_usage "Not enough arguments: $(basename "$0") <var1> [var2, var3...]"

for _var in "$@"; do
    # get's exit code is kept: 1 — no such secret, 2 — pass failed to read it.
    _rc=0
    _val="$("$(dirname "$(realpath "$0")")/get" "${_var}")" || _rc=$?
    if [[ ${_rc} -ne 0 ]]; then
        echo "Failed to get secret: ${_var}" >&2
        exit ${_rc}
    fi
    printf 'export %s=%q\n' "${_var}" "${_val}"
done
