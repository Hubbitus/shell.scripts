#!/usr/bin/bash

source "$(dirname "$(realpath "$0")")/.shared"

[[ $# -ge 1 ]] || die_usage "Not enough arguments: $(basename "$0") <var> [value]"
readonly VAR="${1}"

# Value sources, safest first:
# - stdin pipe:  printf '%s' "$VAL" | secret-set VAR   (trailing newlines stripped, as get/bash-export do on read)
# - tty prompt:  secret-set VAR                        (hidden input, single line)
# - argument:    secret-set VAR 'value'                (visible in ps and shell history — kept for compatibility)
if [[ $# -ge 2 ]]; then
	echo "WARNING: value passed as an argument is visible to other processes (ps) and in shell history." >&2
	echo "         Prefer stdin: ... | $(basename $0) ${VAR}  or a prompt: $(basename $0) ${VAR}" >&2
	VAL="${2}"
elif [[ -t 0 ]]; then
	# EOF (Ctrl-D) is not a failure here: it ends up as an empty value, refused below.
	read -rsp "Value for ${VAR}: " VAL || true
	echo >&2
else
	VAL="$(cat)"
fi
readonly VAL
[[ -n "${VAL}" ]] || { echo "Empty value for ${VAR}: nothing stored" >&2; exit 1; }

readonly ENTRY="${SECRET_STORE_PREFIX}/${PROJECT}/${ENV}/${VAR}"

[[ "${SECRET_DEBUG}" ]] && set -x

# Backup old value, if present
[[ 'true' == "${SECRET_BACKUP}" ]] && pass mv "${ENTRY}" "${SECRET_STORE_PREFIX}/${PROJECT}/${ENV}/_BAK/${VAR}.BAK.$(date --iso-8601=ns)" &>/dev/null || true

# Trace stops before the value is touched: xtrace would print it to stderr.
{ set +x; } 2>/dev/null
printf '%s' "${VAL}" | pass insert --multiline --force "${ENTRY}" &>/dev/null
