#!/usr/bin/bash

set -eo pipefail

: "${SECRET_DEBUG:=}"
: "${SECRET_BACKUP:=true}"
: "${SECRET_STORE_PREFIX:=Hubbitus/@projects}"
: "${SECRET_AUTO_PROJECT_NAME:=true}"

# $1 - base short message
function usage() {
cat <<END
$1
============================
Secrets get/set commands helps your to manage secrets for your projects. Acts as the helpers and wrapper around of pass utility with consequences:
1) pass must be installed and configured
2) All secrets stored *encrypted*! And never saved in plain text files or configs!

There are several utilities:
1. get - for retrieval option. The common example call will be: PROJECT=sample ENV=dev secret/get MY_SECRET_VARIABLE
   Value will be retrieved, decrypted and printed (standard GPG dialog for key issued if key is not in agent cached yet)
2. set - for change options. The common example call will be: PROJECT=sample ENV=dev secret/set MY_SECRET_VARIABLE 'new value'
3. bash-export - for export one or several options in bash source forme like 'NAME=value'. You may just import several options like: 'source <( secret-bash-export VAR1 VAR2 VAR3 )'

Some behavior may be changed with providing env variables:
* 'SECRET_STORE_PREFIX' - pass directory path to store variables
* 'SECRET_DEBUG' - set to 'true' value to provide debug output from those scripts
* 'SECRET_AUTO_PROJECT_NAME' - if set to true (default) name of project will be taken from directory name, containing '.secret.conf' file. See explanation below.

Some implementation notes:
1. If value present, it will be backuped (if SECRET_BACKUP=true, that is default) with suffix '.BAK.$(date --iso-8601=ns)' in pass (our wrapper does not provide way to see it)
2. In you project you may place .secret.conf file and it will be searched traversing path hierarchy up by tree. There may be placed all 'SECRET_*' variables like:

   PROJECT=neinache
   SECRET_DEBUG=true

3. Auto project name mode (SECRET_AUTO_PROJECT_NAME=true) also relies on directory, containing .secret.conf file.
   For example you will call from directory '/some/path/some-project/scripts/' command 'secret/get' and in '/some/path/some-project' found '.secret.conf', then PROJECT will be set to 'some-project' value.
   *NOTE*! Even place '.secret.conf' file without setting any parameters, like a marker file very helpful in this case! Please see '.secret.conf.example' in the repository.

Note! You may use ~/bin/secret-get (and similar) symlinks to ~/bin/secret/get to do not pollute PATH variable vy new directories!
END
}

## Search for the .secret.conf file up to path dirs traversal
_conf=''
while [[ '/' != "$(pwd)" ]] ; do
	if [ -f "$(pwd)/.secret.conf" ]; then
		_conf="$(pwd)/.secret.conf"
		break
	fi
	cd ..
done
if [[ "${_conf}" ]]; then
	[[ "${SECRET_DEBUG}" ]] && echo "[debug] Found secrets config: [${_conf}]. Including." 1>/dev/stderr
	source "${_conf}"
fi

if [[ -z "${PROJECT}" && 'true' == "${SECRET_AUTO_PROJECT_NAME}" && "${_conf}" ]]; then
	PROJECT="$(basename $(dirname ${_conf}))"
	[[ "${SECRET_DEBUG}" ]] && echo "[debug] Project name [${PROJECT}] deducted automatically from the path [${_conf}]" 1>/dev/stderr
fi

: ${ENV?"$(usage "No ENV variable set. Set it to value like dev, test, prod. For example: ENV=dev PROJECT=QWERTY $(basename $0) <var> [value]")"}
: ${PROJECT?"$(usage "No PROJECT variable set. For example: 'PROJECT=QWERTY $(basename $0) <var> [value]'. You may provide it in .secret.conf file, or rely on the SECRET_AUTO_PROJECT_NAME option")"}

readonly SECRET_STORE_PREFIX SECRET_BACKUP

readonly _basename="$(basename $0)"

[[ "${SECRET_DEBUG}" ]] && echo "[debug] Run [${_basename}] on project [${PROJECT}] in ENV=[${ENV}]" 1>/dev/stderr || true
